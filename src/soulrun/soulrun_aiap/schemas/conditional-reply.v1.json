{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulrun_aiap/schemas/conditional-reply.v1.json",
  "title": "F3 conditional human-reply interpretation",
  "description": "Original-source and structural validation only. Never proof of semantic correctness or actual compliance. Submitted by the main executor before normal dispatch/business steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "answer_sha256",
    "choice_intent",
    "selected_items",
    "rejected_items",
    "instructions",
    "ambiguity"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^q[0-9]+-[0-9a-f]+$"
    },
    "answer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "choice_intent": {
      "type": "string",
      "minLength": 1
    },
    "selected_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejected_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "clear",
            "needs_human"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "method",
          "evidence",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "quote"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact full-original substring indexed by Unicode code points, not UTF-8 bytes or UTF-16 code units."
                }
              }
            }
          }
        }
      }
    }
  }
}
