{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soulrun_aiap/contract.v1",
  "title": "Execute Engine rule contract (alpha.97, 04 series doc 233)",
  "description": "One contract file under contracts/: the resident payload rules of one concern, one section per rule, verbatim as served. <<name>> placeholders are filled by the engine. contracts/manifest.json carries each file's sha256 and is checked on load.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "applies",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "contract.v1"
    },
    "id": {
      "enum": [
        "core",
        "start",
        "cache",
        "node",
        "evidence",
        "gate",
        "hsaw",
        "resume",
        "execute-report",
        "final-answer",
        "entry",
        "conditional-reply",
        "engine-faults",
        "module-order"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "applies": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "applies",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+\\.[a-z0-9_]+$"
          },
          "applies": {
            "type": "string",
            "minLength": 1
          },
          "placeholders": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "object",
            "description": "a JSON example served beside the section (hsaw.doubt_gate: hsaw_item_example)"
          }
        }
      }
    }
  }
}
